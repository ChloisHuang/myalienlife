new file mode 100644
index 0000000..78cb737
--- /dev/null
+++ b/OrbitIslandLayoutTests.swift
@@ -0,0 +1,13 @@
+import Foundation
+
+@main struct OrbitIslandLayoutTests {
+    static func main() {
+        precondition(OrbitIslandLayout.matches("local.orbitlife.atoll-preview"))
+        precondition(!OrbitIslandLayout.matches("com.example.other-extension"))
+        let desktop = OrbitIslandLayout.size(available: CGSize(width: 1710, height: 1030))
+        precondition(desktop.width == 600 && desktop.height == 480)
+        let small = OrbitIslandLayout.size(available: CGSize(width: 580, height: 450))
+        precondition(small.width <= 556 && small.height <= 426)
+        print("Orbit island layout: 4 checks passed")
+    }
+}
