diff --git a/DynamicIsland/models/OrbitIslandLayout.swift b/DynamicIsland/models/OrbitIslandLayout.swift
new file mode 100644
index 0000000..22862e2
--- /dev/null
+++ b/DynamicIsland/models/OrbitIslandLayout.swift
@@ -0,0 +1,11 @@
+import Foundation
+
+enum OrbitIslandLayout {
+    static func matches(_ bundleIdentifier: String) -> Bool {
+        bundleIdentifier == "local.orbitlife.atoll-preview"
+    }
+
+    static func size(available: CGSize) -> CGSize {
+        CGSize(width: min(600, available.width - 24), height: min(480, available.height - 24))
+    }
+}
